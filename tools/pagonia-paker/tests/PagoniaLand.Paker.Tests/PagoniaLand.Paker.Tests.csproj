<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\PagoniaLand.Paker.Core\PagoniaLand.Paker.Core.csproj" />
  </ItemGroup>

  <!--
    JsonSchema.Net is a test-only dependency: the paker's report writers stay
    AOT-clean (source-gen JsonSerializerContext), and schema validation only
    runs in the test suite to prove that each shipped report actually matches
    the public schema under schemas/paker/. Test binaries are not AOT-published.
  -->
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.2.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
