<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A purpose-built, content-free stub whose ONLY job is to carry a known Win32
    version resource for GameVersionReader tests. No real game bytes — consistent
    with the repo content policy. The test project references it so it builds, then
    copies its output assembly to a temp folder renamed "Pioneers of Pagonia.exe"
    and asserts GameVersionReader reads the version back.

    The .NET SDK stamps the assembly's version attributes into a Win32 version
    resource, which FileVersionInfo parses cross-platform — exactly the path
    GameVersionReader exercises.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <!-- ProductVersion = InformationalVersion: the full
         <major>.<minor>.<patch>-<build>+<revision> shape mods declare as
         gameDatabaseVersion. FileVersion is the 4-part numeric form that comes
         back truncated (1.3.0.0) — the test asserts the truncation too. -->
    <Version>1.3.0.0</Version>
    <FileVersion>1.3.0.0</FileVersion>
    <InformationalVersion>1.3.0-11768+193445</InformationalVersion>
    <Product>Pioneers of Pagonia</Product>

    <!-- The InformationalVersion already carries +<revision>; stop the SDK from
         appending +<commit-sha>, which would break the exact-match assertion. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
