{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pagonia-land.github.io/Pagonia-Land/schemas/manager/uninstall-report.schema.json",
  "title": "Pagonia Land Manager — Uninstall Report",
  "description": "JSON report emitted by `pagonia-manager uninstall --json <out>`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportKind", "outcome", "parentDirectoryPruned", "diagnostics"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["0.1"] },
    "reportKind": { "type": "string", "enum": ["uninstall"] },
    "outcome": { "type": "string", "enum": ["Failed", "Removed"] },
    "modId": { "type": ["string", "null"] },
    "version": { "type": ["string", "null"] },
    "removedPath": { "type": ["string", "null"] },
    "parentDirectoryPruned": { "type": "boolean" },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "type": "string", "enum": ["Info", "Warning", "Error"] },
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string" },
          "path": { "type": ["string", "null"] }
        }
      }
    }
  }
}
