{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pagonia-land.github.io/Pagonia-Land/schemas/manager/tweak-set.schema.json",
  "title": "Pagonia Land Manager — Tweak Set Report",
  "description": "JSON report emitted by `pagonia-manager tweak set <mod-id> <tweak-id> <value> --json <out>`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportKind", "success", "mutated", "modId", "tweakId", "diagnostics"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["0.1"] },
    "reportKind": { "type": "string", "enum": ["tweakSet"] },
    "success": { "type": "boolean" },
    "mutated": { "type": "boolean" },
    "profile": { "type": ["string", "null"] },
    "modId": { "type": "string", "minLength": 1 },
    "tweakId": { "type": "string", "minLength": 1 },
    "value": { "type": ["string", "null"] },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "type": "string", "enum": ["Info", "Warning", "Error"] },
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string" },
          "path": { "type": ["string", "null"] }
        }
      }
    }
  }
}
