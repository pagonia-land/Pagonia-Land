{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pagonia-land.github.io/Pagonia-Land/schemas/manager/updates-report.schema.json",
  "title": "Pagonia Land Manager — Updates Report",
  "description": "JSON report emitted by `pagonia-manager outdated --json <out>`: the read-only set of installed mods and collections a newer version is published for.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportKind",
    "checkedModCount",
    "skippedLocalModCount",
    "checkedCollectionCount",
    "skippedLocalCollectionCount",
    "modUpdates",
    "collectionUpdates",
    "contentDrifts",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["0.1"] },
    "reportKind": { "type": "string", "enum": ["updates"] },
    "checkedModCount": {
      "description": "Installed mods that carry a remote (gh:) source, so an update check was attempted.",
      "type": "integer",
      "minimum": 0
    },
    "skippedLocalModCount": {
      "description": "Installed mods with no remote source (local folder / zip) — nothing to compare against.",
      "type": "integer",
      "minimum": 0
    },
    "checkedCollectionCount": {
      "description": "Installed collections that carry a remote (gh:) source, so an update check was attempted.",
      "type": "integer",
      "minimum": 0
    },
    "skippedLocalCollectionCount": {
      "description": "Installed collections with no remote source (local-file install) — nothing to compare against.",
      "type": "integer",
      "minimum": 0
    },
    "modUpdates": {
      "type": "array",
      "items": { "$ref": "#/$defs/update" }
    },
    "collectionUpdates": {
      "type": "array",
      "items": { "$ref": "#/$defs/update" }
    },
    "contentDrifts": {
      "description": "Installed mods whose source re-published the SAME version with changed content (advertised contentHash != installed payload hash).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "advertisedHash", "installedHash"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "advertisedHash": { "type": "string" },
          "installedHash": { "type": "string" }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "type": "string", "enum": ["Info", "Warning", "Error"] },
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string" },
          "path": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "installedVersion", "availableVersion", "gameDatabaseVersion"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "installedVersion": { "type": "string", "minLength": 1 },
        "availableVersion": { "type": "string", "minLength": 1 },
        "gameDatabaseVersion": {
          "description": "The version the available release targets, as advertised in the source index.yaml. May be empty if the index entry omits it.",
          "type": "string"
        }
      }
    }
  }
}
