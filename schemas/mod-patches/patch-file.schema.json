{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pagonia-land/Pagonia-Land/schemas/mod-patches/patch-file.schema.json",
  "title": "Pagonia Land Patch File",
  "description": "v0.1 schema for patch operation files referenced by a Pagonia Land mod manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operations"
  ],
  "properties": {
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 2,
          "maxLength": 120
        },
        "operation": {
          "type": "string",
          "enum": [
            "replaceValue",
            "replaceAttribute",
            "addListItem",
            "mergeComponent",
            "removeListItem",
            "replaceNode",
            "addEntity",
            "removeEntity"
          ]
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "very-high"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "expectedOldValue": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "attribute": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "expectedOldXml": {
          "type": "string",
          "minLength": 1
        },
        "xml": {
          "type": "string",
          "minLength": 1
        },
        "resourceGuid": {
          "$ref": "#/$defs/guid"
        },
        "resourceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "replaceValue"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "required": [
              "expectedOldValue",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "replaceAttribute"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "required": [
              "attribute",
              "expectedOldValue",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "addListItem",
                  "mergeComponent",
                  "replaceNode",
                  "addEntity"
                ]
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "required": [
              "xml"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "removeListItem",
                  "removeEntity"
                ]
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "required": [
              "expectedOldXml"
            ]
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/gameXmlPath"
        },
        "entityGuid": {
          "$ref": "#/$defs/guid"
        },
        "entityName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "anyOf": [
        {
          "required": [
            "entityGuid"
          ]
        },
        {
          "required": [
            "entityName"
          ]
        }
      ]
    },
    "gameXmlPath": {
      "type": "string",
      "pattern": "^(core|decorations1|dlc1|tools)/(gdb|maps)/[^\\\\:*?\"<>|]+\\.gd\\.xml$",
      "maxLength": 260
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  }
}
